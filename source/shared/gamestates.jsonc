/*
 * This file is enforced by schema file located at 'bga-ts-template/template/schema'. If you are using VS Code, this schema file will be linked to this file automatically if 'generate-vscode-files' is set to true in 'template.config.jsonc. Hover over any fields for more information.
 *
 * Game state machine is a tool used to facilitate game development. Please check the BGA Studio presentation about game state to understand this, and associated documentation.
 *
 * !! It is not a good idea to modify this file when a game is running !!
 */
{
	//"$schema": "../../node_modules/bga-ts-template/schema/gamestates.schema.json",

	// The initial state. Please do not modify.
	"gameSetup": {
		"description": "",
		"type": "manager",
		//"action": "stGameSetup",
		"transitions": {
			"": "leaderSelection"
		}
	},

	// Note: ID=2: your first state. If not, change the transition in the gameSetup above.
	"leaderSelection": {
		"description": "${actplayer} must select a leader",
		"descriptionmyturn": "${you} must select a leader",
		"type": "activeplayer",
		"relatedGameState": {
			"transitions": {
				"selectLeader": "leaderSelection",
				"allSelectedLeader": "prepareBoards"
			}
		},
		"possibleactions": {
			"selectLeader": [
				{
					"name": "leader_id",
					"type": "AT_int"
				}
			],
		},
		"transitions": {
			"selected": "leaderSelectionGame",
			"notSelected": "leaderSelection"
		}
	},
	"prepareBoards": {
		"type": "game",
		"transitions": {
			"startGame": "roundSetup"
		}
	},
	"roundSetup": {
		"type": "game",
		"transitions": {
			"startRound": "playerTurn",
			"gameOver": "gameEnd"
		}
	},
	"playerTurn": {
		"description": "${actplayer} must play a card",
		"descriptionmyturn": "${you} must play a card",
		"type": "activeplayer",
		"relatedGameState": {
			"transitions": {
				"nextPlayer": "playerTurn",
				"startAtkPhase": "atkPhase"
			}
		},
		"possibleactions": {
			"pickDeckCard":[
			],
			"putCard": [
				{
					"name": "card_id",
					"type": "AT_int"
				},
				{
					"name": "rotation",
					"type": "AT_int"
				},
				{
					"name": "pos_x",
					"type": "AT_int"
				},
				{
					"name": "pos_y",
					"type": "AT_int"
				}
			],
		},
		"transitions": {
			"deckCardPicked": "playerTurn",
			"retry": "playerTurn",
			"turnEnded": "playerTurnGame"
		}
	},
	"atkPhase": {
		"description": "${actplayer} is attacking the other leaders",
		"descriptionmyturn": "${you} are attacking the other leaders",
		"type": "activeplayer",
		"relatedGameState": {
			"transitions": {
				"nextPlayer": "atkPhase",
				"atkPhaseEnded": "healingPhase",
			}
		},
		"possibleactions": {
			"attack": [],
		},
		"transitions": {
			"turnEnded": "atkPhaseGame",
		}
	},
	"healingPhase": {
		"description": "${actplayer} is healing themself",
		"descriptionmyturn": "${you} are healing yourself",
		"type": "activeplayer",
		"relatedGameState": {
			"transitions": {
				"nextPlayer": "healingPhase",
				"healingPhaseEnded": "roundSetup",
			}
		},
		"possibleactions": {
			"heal": [],
		},
		"transitions": {
			"turnEnded": "healingPhaseGame",
		}
	},

	// Final state.
	// Please do not modify (and do not overload action/args methods}.
	"gameEnd": {
		"description": "End of game",
		"type": "manager",
		//"action": "stGameEnd",
		"args": "argGameEnd",
		"argsType": "object" // Automatically typed by framework.
	}
}